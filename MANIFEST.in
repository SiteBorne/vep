include LICENSE README.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md CHANGELOG.md SUPPORT.md pyproject.toml MANIFEST.in
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include tests *.py *.json *.sql
recursive-include scripts *.py *.sh *.json
recursive-include benchmarks *.py
recursive-include .github *.yml
prune tests/__pycache__
global-exclude __pycache__ *.py[cod] *.pem *.key *.db .env
exclude release-gate.json
exclude docs/RELEASE_GATE_REPORT.md
recursive-include conformance *.json *.mjs
recursive-include docs *.json
recursive-include benchmarks *.json
exclude launch-gate.json
graft tests/fixtures
graft plugins
prune benchmarks/results/hosted-linux-perf-run-39719640989
prune benchmarks/results/hosted-linux-perf-run-39721614817
prune benchmarks/results/hosted-linux-perf-run-39747018211
prune benchmarks/results/hosted-linux-perf-run-39755218641
